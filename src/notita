    def _finish_open(self) -> None:
        if self.initial_click_through and self._set_click_through(True):
            return
        self._force_focus()
        self.root.after(80, self._refresh_opacity_for_pointer)

    def _force_focus(self) -> None:
        try:
            self.root.lift()
            self.root.focus_force()
            if self.read_only:
                self.text_widget.configure(state="disabled")
            else:
                self.text_widget.configure(state="normal")
                self.text_widget.focus_force()
                self.text_widget.mark_set("insert", "end")
        except tk.TclError:
            return

    def _bind_presence_events(self) -> None:
        for widget in self._all_note_widgets():
            widget.bind("<Enter>", self._activate_opacity, add="+")
            widget.bind("<Leave>", self._schedule_idle_opacity, add="+")

    def _bind_drop_targets(self) -> None:
        if not self.dnd_available or DND_FILES is None:
            return
        for widget in (self.root, self.body, self.text_widget, self.toolbar_handle):
            try:
                widget.drop_target_register(DND_FILES)
                widget.dnd_bind("<<Drop>>", self._on_drop_files)
            except (AttributeError, tk.TclError):
                continue

    def _on_drop_files(self, event: tk.Event) -> str:
        if self.read_only:
            return "break"
        paths = self._paths_from_drop(str(getattr(event, "data", "")))
        if not paths:
            return "break"
        drop_x = int(getattr(event, "x_root", self.body.winfo_rootx() + 16)) - self.body.winfo_rootx()
        drop_y = int(getattr(event, "y_root", self.body.winfo_rooty() + 28)) - self.body.winfo_rooty()
        x = max(0, drop_x)
        y = max(0, drop_y)
        added = 0
        for path in paths:
            if self._add_image_from_path(path, x=x + (added * 12), y=y + (added * 12), quiet=True):
                added += 1
        return "break"

    def _paths_from_drop(self, data: str) -> list[str]:
        paths = []
        try:
            raw_items = self.root.tk.splitlist(data)
        except tk.TclError:
            raw_items = data.split()
        for item in raw_items:
            value = str(item).strip()
            if not value:
                continue
            parsed = urlparse(value)
            if parsed.scheme == "file":
                value = unquote(parsed.path)
            path = Path(value).expanduser()
            if not path.is_file():
                continue
            if self._is_supported_image(path):
                paths.append(str(path))
        return paths

    def _is_supported_image(self, path: Path) -> bool:
        try:
            with Image.open(path) as img:
                img.verify()
        except Exception:
            return False
        return True

    def _all_note_widgets(self) -> list[tk.Misc]:
        widgets = [self.root]
        for widget in list(widgets):
            for child in widget.winfo_children():
                if isinstance(child, tk.Menu):
                    continue
                widgets.append(child)
        return widgets

    def _activate_opacity(self, _: tk.Event | None = None) -> None:
        if self.opacity_idle_job is not None:
            self.root.after_cancel(self.opacity_idle_job)
            self.opacity_idle_job = None
        self._set_opacity(self.active_opacity)

    def _schedule_idle_opacity(self, _: tk.Event | None = None) -> None:
        if self.opacity_idle_job is not None:
            self.root.after_cancel(self.opacity_idle_job)
        self.opacity_idle_job = self.root.after(90, self._idle_opacity_if_pointer_left)

    def _idle_opacity_if_pointer_left(self) -> None:
        self.opacity_idle_job = None
        if self._pointer_inside_note():
            return
        self._set_opacity(self.idle_opacity)

    def _pointer_inside_note(self) -> bool:
        widget = self.root.winfo_containing(self.root.winfo_pointerx(), self.root.winfo_pointery())
        return widget is not None and str(widget).startswith(str(self.root))

    def _refresh_opacity_for_pointer(self) -> None:
        self._set_opacity(self.active_opacity if self._pointer_inside_note() else self.idle_opacity)

    def _set_opacity(self, value: float) -> None:
        value = max(0.05, min(1.0, float(value)))
        try:
            self.root.attributes("-alpha", value)
        except tk.TclError:
            return

    def _configure_text_tags(self) -> None:
        bold_font = tkfont.Font(family=self.font_family, size=self.font_size, weight="bold")
        italic_font = tkfont.Font(family=self.font_family, size=self.font_size, slant="italic")
        code_font = tkfont.Font(family="Monospace", size=self.font_size)
        big_font = tkfont.Font(family=self.font_family, size=min(36, self.font_size + 3))
        small_font = tkfont.Font(family=self.font_family, size=max(6, self.font_size - 2))
        title_font = tkfont.Font(family=self.font_family, size=min(42, self.font_size + 7), weight="bold")
        self.style_fonts = [bold_font, italic_font, code_font, big_font, small_font, title_font]
        self.text_widget.tag_configure("fmt_bold", font=bold_font)
        self.text_widget.tag_configure("fmt_italic", font=italic_font)
        self.text_widget.tag_configure("fmt_underline", underline=True)
        self.text_widget.tag_configure("fmt_strike", overstrike=True)
        self.text_widget.tag_configure("fmt_code", font=code_font, background="#eeeeee", foreground="#222222")
        self.text_widget.tag_configure("fmt_highlight", background="#fff2a8")
        self.text_widget.tag_configure("fmt_big", font=big_font)
        self.text_widget.tag_configure("fmt_small", font=small_font)
        self.text_widget.tag_configure("fmt_title", font=title_font, spacing1=3, spacing3=3)

    def _build_toolbar(self) -> None:
        buttons = [
            ("B", "Ctrl+B", lambda: self._toggle_style("fmt_bold")),
            ("I", "Ctrl+I", lambda: self._toggle_style("fmt_italic")),
            ("U", "Ctrl+U", lambda: self._toggle_style("fmt_underline")),
            ("S", "Ctrl+Shift+X", lambda: self._toggle_style("fmt_strike")),
            ("`", "Ctrl+E", lambda: self._toggle_style("fmt_code")),
            ("H", "Ctrl+H", lambda: self._toggle_style("fmt_highlight")),
            ("Img", "Insertar imagen", self._insert_image_dialog),
            ("A+", "Ctrl++", lambda: self._toggle_style("fmt_big")),
            ("A-", "Ctrl+-", lambda: self._toggle_style("fmt_small")),
            ("T", "Titulo", lambda: self._toggle_style("fmt_title")),
        ]
        for label, hint, command in buttons[:7]:
            self._toolbar_button(label, hint, command).pack(side="left", padx=1, pady=1)
        more = self._toolbar_button("...", "Mas opciones", self._open_toolbar_more)
        more.pack(side="left", padx=1, pady=1)
        self.more_button = more
        self.toolbar_more = tk.Menu(self.root, tearoff=0)
        for label, hint, command in buttons[6:]:
            self.toolbar_more.add_command(label=f"{label}  {hint}", command=command)
        self.toolbar_more.add_separator()
        self.toolbar_more.add_command(label="Color texto...", command=self._set_fg_color)
        self.toolbar_more.add_command(label="Color fondo...", command=self._set_bg_color)
        self.toolbar_more.add_command(label="Cambiar fuente...", command=self._set_font)
        self.toolbar_more.add_command(label="Insertar imagen/GIF...", command=self._insert_image_dialog)
        self.toolbar_more.add_command(label="Guardar como .txt/.md...", command=self._export_note_dialog)
        self.toolbar_more.add_command(label="Limpiar formato", command=self._clear_selection_format)

    def _toolbar_button(self, label: str, hint: str, command) -> tk.Button:
        button = tk.Button(
            self.toolbar,
            text=label,
            command=command,
            width=max(2, min(4, len(label))),
            height=1,
            padx=2,
            pady=0,
            bd=0,
            relief="flat",
            bg="#dddddd",
            fg="#202020",
            activebackground="#eeeeee",
            cursor="hand2",
            font=("Sans", 8, "bold"),
            takefocus=False,
        )
        button.bind("<Enter>", lambda _: self._show_toolbar())
        button.bind("<Leave>", lambda _: self._schedule_toolbar_hide())
        button.bind("<Button-3>", lambda _: self._show_toolbar())
        button.bind("<FocusIn>", lambda _: self._show_toolbar())
        button.tooltip_text = hint
        return button

    def _show_toolbar(self) -> None:
        if self.toolbar_hide_job is not None:
            self.root.after_cancel(self.toolbar_hide_job)
            self.toolbar_hide_job = None
        if not self.toolbar_visible:
            self.toolbar.pack(fill="x", side="top", before=self.toolbar_handle)
            self.toolbar_visible = True
            self.root.after_idle(self._reapply_click_through)

    def _schedule_toolbar_hide(self) -> None:
        if self.toolbar_hide_job is not None:
            self.root.after_cancel(self.toolbar_hide_job)
        self.toolbar_hide_job = self.root.after(700, self._hide_toolbar_if_idle)

    def _hide_toolbar_if_idle(self) -> None:
        self.toolbar_hide_job = None
        widget = self.root.winfo_containing(self.root.winfo_pointerx(), self.root.winfo_pointery())
        if widget is not None and str(widget).startswith(str(self.toolbar)):
            return
        self.toolbar.pack_forget()
        self.toolbar_visible = False
        self.root.after_idle(self._reapply_click_through)

    def _open_toolbar_more(self) -> None:
        self._show_toolbar()
        self.toolbar_more.tk_popup(self.more_button.winfo_rootx(), self.more_button.winfo_rooty() + self.more_button.winfo_height())
        self.toolbar_more.grab_release()

