    def _copy_selection(self, _: tk.Event | None = None) -> str:
        try:
            text = self.text_widget.get("sel.first", "sel.last")
        except tk.TclError:
            return "break"
        self.root.clipboard_clear()
        self.root.clipboard_append(text)
        return "break"

    def _cut_selection(self, _: tk.Event | None = None) -> str:
        if self.read_only:
            return self._copy_selection()
        try:
            text = self.text_widget.get("sel.first", "sel.last")
            self.text_widget.delete("sel.first", "sel.last")
        except tk.TclError:
            return "break"
        self.root.clipboard_clear()
        self.root.clipboard_append(text)
        self._schedule_save()
        return "break"

    def _paste_clipboard(self, _: tk.Event | None = None) -> str:
        if self.read_only:
            return "break"
        try:
            text = self.root.clipboard_get()
        except tk.TclError:
            return "break"
        if self._selection_bounds() is not None:
            self.text_widget.delete("sel.first", "sel.last")
        start = self.text_widget.index("insert")
        self.text_widget.insert("insert", text)
        end = self.text_widget.index("insert")
        for tag in self.pending_style_tags:
            self.text_widget.tag_add(tag, start, end)
        self._schedule_save()
        return "break"

    def _shortcut_style(self, tag: str) -> str:
        self._toggle_style(tag)
        return "break"

    def _selection_bounds(self) -> tuple[str, str] | None:
        try:
            return self.text_widget.index("sel.first"), self.text_widget.index("sel.last")
        except tk.TclError:
            return None

    def _toggle_style(self, tag: str) -> None:
        if self.read_only:
            return
        bounds = self._selection_bounds()
        if bounds is None:
            if tag in self.pending_style_tags:
                self.pending_style_tags.remove(tag)
                self.text_widget.tag_remove(tag, "insert", "insert")
            else:
                self.pending_style_tags.add(tag)
                self.text_widget.tag_add(tag, "insert", "insert")
            return
        start, end = bounds
        ranges = self.text_widget.tag_nextrange(tag, start, end)
        if ranges and self.text_widget.compare(ranges[0], "<=", start) and self.text_widget.compare(ranges[1], ">=", end):
            self.text_widget.tag_remove(tag, start, end)
        else:
            self.text_widget.tag_add(tag, start, end)
        self._schedule_save()

    def _clear_selection_format(self) -> None:
        bounds = self._selection_bounds()
        if bounds is None:
            self.pending_style_tags.clear()
            return
        start, end = bounds
        for tag in STYLE_TAGS:
            self.text_widget.tag_remove(tag, start, end)
        self._schedule_save()

    def _apply_pending_style_to_recent_input(self, event: tk.Event) -> None:
        if not self.pending_style_tags:
            return
        if event.keysym in {"Shift_L", "Shift_R", "Control_L", "Control_R", "Alt_L", "Alt_R", "BackSpace", "Delete"}:
            return
        if not event.char and event.keysym not in {"Return", "Tab", "space"}:
            return
        try:
            start = self.text_widget.index("insert-1c")
            end = self.text_widget.index("insert")
        except tk.TclError:
            return
        for tag in self.pending_style_tags:
            self.text_widget.tag_add(tag, start, end)
        self._schedule_save()

    def _dump_format_ranges(self) -> list[dict]:
        ranges = []
        for tag in STYLE_TAGS:
            tag_ranges = self.text_widget.tag_ranges(tag)
            for idx in range(0, len(tag_ranges), 2):
                start = str(tag_ranges[idx])
                end = str(tag_ranges[idx + 1])
                if self.text_widget.compare(start, "<", end):
                    ranges.append({"tag": tag, "start": self._index_to_offset(start), "end": self._index_to_offset(end)})
        return ranges

    def _restore_format_ranges(self, ranges: list[dict]) -> None:
        text_end = self.text_widget.index("end-1c")
        for item in ranges:
            tag = item.get("tag")
            if tag not in STYLE_TAGS:
                continue
            try:
                start = self._offset_to_index(int(item.get("start", 0)))
                end = self._offset_to_index(int(item.get("end", 0)))
            except (TypeError, ValueError, tk.TclError):
                continue
            if self.text_widget.compare(start, ">=", text_end) or self.text_widget.compare(start, ">=", end):
                continue
            if self.text_widget.compare(end, ">", text_end):
                end = text_end
            self.text_widget.tag_add(tag, start, end)

    def _index_to_offset(self, index: str) -> int:
        return int(self.text_widget.tk.call(self.text_widget._w, "count", "-chars", "1.0", index))

    def _offset_to_index(self, offset: int) -> str:
        return self.text_widget.index(f"1.0+{max(0, offset)}c")

    def _insert_image_dialog(self) -> None:
        if self.read_only:
            return
        path = filedialog.askopenfilename(
            parent=self.root,
            title="Insertar imagen o GIF",
            filetypes=[
                ("Imagenes", "*.png *.jpg *.jpeg *.gif *.webp *.bmp"),
                ("Todos los archivos", "*"),
            ],
        )
        if not path:
            return
        self._add_image_from_path(path)

    def _add_image_from_path(self, path: str, x: int = 16, y: int | None = None, quiet: bool = False) -> bool:
        try:
            image = FloatingImage.from_file(self, path, x=x, y=y if y is not None else max(22, 8 + (24 if self.toolbar_visible else 0)))
        except Exception:
            if not quiet:
                messagebox.showerror("Imagen no valida", "No se pudo insertar esa imagen.", parent=self.root)
            return False
        self.images.append(image)
        image.frame.lift()
        self._refresh_opacity_for_pointer()
        self._schedule_save()
        self._reapply_click_through()
        return True

    def _restore_images(self, records: list[dict]) -> None:
        for record in records:
            try:
                image = FloatingImage(self, record)
            except Exception:
                continue
            self.images.append(image)
        if self.images:
            self.root.after_idle(self._refresh_opacity_for_pointer)

    def _dump_images(self) -> list[dict]:
        return [image.to_record() for image in self.images]

    def send_image_back(self, image: FloatingImage) -> None:
        if image not in self.images:
            return
        image.frame.lift(self.text_widget)
        for other in self.images:
            if other is not image:
                other.frame.lift(image.frame)
        self._reapply_click_through()

