def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Crear notita de sigilo extremo.")
    parser.add_argument("text", nargs="*", help="Texto inicial")
    parser.add_argument("--width", type=int, default=140)
    parser.add_argument("--height", type=int, default=70)
    parser.add_argument("--x", type=int)
    parser.add_argument("--y", type=int)
    parser.add_argument("--active-opacity", type=float, default=0.72)
    parser.add_argument("--idle-opacity", type=float, default=0.18)
    parser.add_argument("--bg", default="#d7d7d7")
    parser.add_argument("--fg", default="#2f2f2f")
    parser.add_argument("--font-size", type=int, default=9)
    parser.add_argument("--font-family", default="Sans")
    parser.add_argument("--format-json", default="", help=argparse.SUPPRESS)
    parser.add_argument("--images-json", default="", help=argparse.SUPPRESS)
    parser.add_argument("--read-only", action="store_true", help="Abrir sin modo edicion")
    parser.add_argument("--click-through", action="store_true", help="Dejar pasar clics a ventanas debajo (X11)")
    parser.add_argument("--frameless", action="store_true", help="Sin decoraciones (puede romper escritura en Linux)")
    parser.add_argument("--topmost", dest="topmost", action="store_true", default=True)
    parser.add_argument("--no-topmost", dest="topmost", action="store_false")
    parser.add_argument("--note-id", default="")
    parser.add_argument(
        "--restore",
        nargs="?",
        const="prompt",
        help="Restaurar historial: prompt | all | N",
    )
    return parser.parse_args()


def _ensure_state() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)


def _read_history() -> dict:
    _ensure_state()
    if not HISTORY_FILE.exists():
        return {"notes": []}
    try:
        return json.loads(HISTORY_FILE.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return {"notes": []}


def _write_history(data: dict) -> None:
    _ensure_state()
    tmp = HISTORY_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
    os.replace(tmp, HISTORY_FILE)


def upsert_note_record(record: dict) -> None:
    data = _read_history()
    notes = data.get("notes", [])
    notes = [n for n in notes if n.get("id") != record.get("id")]
    notes.append(record)
    notes = sorted(notes, key=lambda n: n.get("updated_at", 0), reverse=True)[:500]
    data["notes"] = notes
    _write_history(data)


def delete_note_record(note_id: str) -> None:
    if not note_id:
        return
    data = _read_history()
    notes = data.get("notes", [])
    data["notes"] = [n for n in notes if n.get("id") != note_id]
    _write_history(data)


def clear_history() -> None:
    _write_history({"notes": []})


def get_recent_notes() -> list[dict]:
    data = _read_history()
    notes = data.get("notes", [])
    return sorted(notes, key=lambda n: n.get("updated_at", 0), reverse=True)


def spawn_note_from_record(record: dict) -> None:
    cmd = [
        sys.executable,
        __file__,
        "--note-id",
        str(record.get("id", "")),
        "--width",
        str(int(record.get("width", 210))),
        "--height",
        str(int(record.get("height", 110))),
        "--x",
        str(int(record.get("x", 100))),
        "--y",
        str(int(record.get("y", 100))),
        "--active-opacity",
        str(float(record.get("active_opacity", 0.72))),
        "--idle-opacity",
        str(float(record.get("idle_opacity", 0.18))),
        "--bg",
        str(record.get("bg", "#d7d7d7")),
        "--fg",
        str(record.get("fg", "#2f2f2f")),
        "--font-size",
        str(int(record.get("font_size", 9))),
        "--font-family",
        str(record.get("font_family", "Sans")),
        "--format-json",
        json.dumps(record.get("format", []), ensure_ascii=False),
        "--images-json",
        json.dumps(record.get("images", []), ensure_ascii=False),
        str(record.get("text", "")),
    ]
    if record.get("topmost"):
        cmd.append("--topmost")
    if record.get("read_only"):
        cmd.append("--read-only")
    if record.get("click_through"):
        cmd.append("--click-through")
    subprocess.Popen(cmd, start_new_session=True)


class X11InputShape:
    def __init__(self) -> None:
        self.display = None
        if xdisplay is None or shape is None or X is None or not os.environ.get("DISPLAY"):
            return
        try:
            candidate = xdisplay.Display()
            if candidate.has_extension("SHAPE"):
                candidate.set_error_handler(lambda *_: None)
                self.display = candidate
            else:
                candidate.close()
        except Exception:
            self.display = None

    @property
    def available(self) -> bool:
        return self.display is not None

    def set_passthrough(self, root: tk.Misc, enabled: bool, control_widgets: set[tk.Misc] | None = None) -> bool:
        if self.display is None:
            return False
        control_widgets = control_widgets or set()
        try:
            root.update_idletasks()
            for widget in self._walk_widgets(root):
                if not enabled:
                    self._set_widget_input(widget, self._widget_rects(widget))
                elif widget == root:
                    self._set_widget_input(widget, self._control_rects(root, control_widgets))
                elif widget in control_widgets:
                    self._set_widget_input(widget, self._widget_rects(widget))
                else:
                    self._set_widget_input(widget, [])
            self.display.sync()
            return True
        except Exception:
            return False

    def _walk_widgets(self, widget: tk.Misc) -> list[tk.Misc]:
        if isinstance(widget, tk.Menu):
            return []
        widgets = [widget]
        for child in widget.winfo_children():
            widgets.extend(self._walk_widgets(child))
        return widgets

    def _widget_rects(self, widget: tk.Misc) -> list[tuple[int, int, int, int]]:
        return [(0, 0, max(1, widget.winfo_width()), max(1, widget.winfo_height()))]

    def _control_rects(self, root: tk.Misc, control_widgets: set[tk.Misc]) -> list[tuple[int, int, int, int]]:
        rects = []
        root_x = root.winfo_rootx()
        root_y = root.winfo_rooty()
        for widget in control_widgets:
            rects.append(
                (
                    widget.winfo_rootx() - root_x,
                    widget.winfo_rooty() - root_y,
                    max(1, widget.winfo_width()),
                    max(1, widget.winfo_height()),
                )
            )
        return rects

    def _set_widget_input(self, widget: tk.Misc, rects: list[tuple[int, int, int, int]]) -> None:
        win_id = widget.winfo_id()
        if not win_id:
            return
        for win in self._window_chain(win_id, widget == widget.winfo_toplevel()):
            win.shape_rectangles(shape.SO.Set, shape.SK.Input, X.Unsorted, 0, 0, rects)

    def _window_chain(self, win_id: int, include_parents: bool) -> list:
        win = self.display.create_resource_object("window", win_id)
        windows = [win]
        if not include_parents:
            return windows
        while True:
            tree = win.query_tree()
            parent = tree.parent
            if parent.id == tree.root.id:
                return windows
            windows.append(parent)
            win = parent


class FloatingImage:
    def __init__(self, note: GhostNote, record: dict) -> None:
        self.note = note
        self.image_id = str(record.get("id") or uuid.uuid4().hex)
        self.path = str(record.get("path") or "")
        self.store_path = str(record.get("store_path") or "")
        self.data = str(record.get("data") or "")
        self.name = str(record.get("name") or Path(self.path).name or "imagen")
        self.x = int(record.get("x", 12))
        self.y = int(record.get("y", 24))
        self.width = max(24, int(record.get("width", 160)))
        self.height = max(24, int(record.get("height", 120)))
        self.drag_start = (0, 0, self.x, self.y)
        self.resize_start = (0, 0, self.width, self.height)
        self.frame = tk.Frame(note.body, bg="#f4f4f4", highlightthickness=1, highlightbackground="#666666", bd=0)
        self.label = tk.Label(self.frame, bg="#f4f4f4", bd=0)
        self.label.pack(fill="both", expand=True)
        self.grip = tk.Frame(self.frame, bg="#555555", width=10, height=10, cursor="bottom_right_corner")
        self.grip.place(relx=1.0, rely=1.0, anchor="se")
        self.frames: list[Image.Image] = []
        self.photo: ImageTk.PhotoImage | None = None
        self.frame_index = 0
        self.animation_job: str | None = None
        self._materialize_embedded_data()
        self._load_frames()
        self._bind_events()
        self.place()
        self.render()

    def _materialize_embedded_data(self) -> None:
        if self.store_path or not self.data:
            return
        try:
            raw = base64.b64decode(self.data)
        except Exception:
            return
        suffix = Path(self.path).suffix.lower() or ".img"
        IMAGE_DIR.mkdir(parents=True, exist_ok=True)
        store_path = IMAGE_DIR / f"{self.image_id}{suffix}"
        store_path.write_bytes(raw)
        self.store_path = str(store_path)
        self.data = ""

    @classmethod
    def from_file(cls, note: GhostNote, path: str, x: int = 16, y: int = 28) -> FloatingImage:
        raw = Path(path).read_bytes()
        image_id = uuid.uuid4().hex
        suffix = Path(path).suffix.lower() or ".img"
        IMAGE_DIR.mkdir(parents=True, exist_ok=True)
        store_path = IMAGE_DIR / f"{image_id}{suffix}"
        store_path.write_bytes(raw)
        with Image.open(io.BytesIO(raw)) as img:
            w, h = img.size
        max_w = max(80, note.root.winfo_width() - 28)
        max_h = max(80, note.root.winfo_height() - 48)
        scale = min(1.0, max_w / max(1, w), max_h / max(1, h))
        return cls(
            note,
            {
                "id": image_id,
                "path": path,
                "store_path": str(store_path),
                "name": Path(path).name,
                "x": x,
                "y": y,
                "width": max(24, int(w * scale)),
                "height": max(24, int(h * scale)),
            },
        )

    def _load_frames(self) -> None:
        if self.store_path and Path(self.store_path).exists():
            raw = Path(self.store_path).read_bytes()
        elif self.data:
            raw = base64.b64decode(self.data)
        else:
            raw = Path(self.path).read_bytes()
        with Image.open(io.BytesIO(raw)) as img:
            self.frames = [frame.convert("RGBA") for frame in ImageSequence.Iterator(img)]
        if not self.frames:
            raise ValueError("imagen sin frames")

    def _bind_events(self) -> None:
        for widget in (self.frame, self.label):
            widget.bind("<ButtonPress-1>", self._start_drag)
            widget.bind("<B1-Motion>", self._drag)
            widget.bind("<Button-3>", self._open_menu)
            widget.bind("<Enter>", self.note._activate_opacity, add="+")
            widget.bind("<Leave>", self.note._schedule_idle_opacity, add="+")
        self.grip.bind("<ButtonPress-1>", self._start_resize)
        self.grip.bind("<B1-Motion>", self._resize)
        self.grip.bind("<Button-3>", self._open_menu)
        self.frame.bind("<Destroy>", self._on_destroy, add="+")

    def _on_destroy(self, event: tk.Event) -> None:
        if event.widget is self.frame and self.animation_job is not None:
            try:
                self.note.root.after_cancel(self.animation_job)
            except tk.TclError:
                pass
            self.animation_job = None

    def place(self) -> None:
        self._clamp_geometry()
        self.frame.place(x=self.x, y=self.y, width=self.width, height=self.height)

    def _clamp_geometry(self) -> None:
        body_w = self.note.body.winfo_width()
        body_h = self.note.body.winfo_height()
        max_w = max(24, body_w if body_w > 24 else self.note.root.winfo_width())
        max_h = max(24, body_h if body_h > 24 else self.note.root.winfo_height())
        self.width = max(24, min(self.width, max_w))
        self.height = max(24, min(self.height, max_h))
        self.x = max(0, min(self.x, max(0, max_w - self.width)))
        self.y = max(0, min(self.y, max(0, max_h - self.height)))

    def render(self) -> None:
        frame = self.frames[self.frame_index % len(self.frames)]
        resized = frame.resize((max(1, self.width), max(1, self.height)), Image.Resampling.LANCZOS)
        self.photo = ImageTk.PhotoImage(resized)
        self.label.configure(image=self.photo)
        self._schedule_animation()

    def _schedule_animation(self) -> None:
        if self.animation_job is not None:
            self.note.root.after_cancel(self.animation_job)
            self.animation_job = None
        if len(self.frames) <= 1:
            return
        delay = int(self.frames[self.frame_index % len(self.frames)].info.get("duration", 90) or 90)
        self.animation_job = self.note.root.after(max(30, delay), self._next_frame)

    def _next_frame(self) -> None:
        self.animation_job = None
        self.frame_index = (self.frame_index + 1) % len(self.frames)
        self.render()

    def _start_drag(self, event: tk.Event) -> None:
        self.frame.lift()
        self.drag_start = (event.x_root, event.y_root, self.x, self.y)

    def _drag(self, event: tk.Event) -> None:
        sx, sy, ox, oy = self.drag_start
        self.x = ox + (event.x_root - sx)
        self.y = oy + (event.y_root - sy)
        self.place()
        self.note._schedule_save()
        self.note._reapply_click_through()

    def _start_resize(self, event: tk.Event) -> None:
        self.frame.lift()
        self.resize_start = (event.x_root, event.y_root, self.width, self.height)

    def _resize(self, event: tk.Event) -> None:
        sx, sy, ow, oh = self.resize_start
        self.width = ow + (event.x_root - sx)
        self.height = oh + (event.y_root - sy)
        self.place()
        self.render()
        self.note._schedule_save()
        self.note._reapply_click_through()

    def _open_menu(self, event: tk.Event) -> str:
        menu = tk.Menu(self.note.root, tearoff=0)
        menu.add_command(label="Traer al frente", command=self.frame.lift)
        menu.add_command(label="Enviar atras", command=lambda: self.note.send_image_back(self))
        menu.add_command(label="Tamano original", command=self.reset_size)
        menu.add_command(label="Ajustar a nota", command=self.fit_to_note)
        menu.add_separator()
        menu.add_command(label="Eliminar imagen", command=self.delete)
        menu.tk_popup(event.x_root, event.y_root)
        menu.grab_release()
        return "break"

    def reset_size(self) -> None:
        w, h = self.frames[0].size
        self.width = max(24, w)
        self.height = max(24, h)
        self.place()
        self.render()
        self.note._schedule_save()
        self.note._reapply_click_through()

    def fit_to_note(self) -> None:
        w, h = self.frames[0].size
        max_w = max(80, self.note.root.winfo_width() - 28)
        max_h = max(80, self.note.root.winfo_height() - 48)
        scale = min(max_w / max(1, w), max_h / max(1, h))
        self.width = max(24, int(w * scale))
        self.height = max(24, int(h * scale))
        self.x = min(self.x, max(0, self.note.root.winfo_width() - self.width))
        self.y = min(self.y, max(0, self.note.root.winfo_height() - self.height))
        self.place()
        self.render()
        self.note._schedule_save()
        self.note._reapply_click_through()

    def delete(self) -> None:
        if self.animation_job is not None:
            self.note.root.after_cancel(self.animation_job)
        self.frame.destroy()
        self.note.images = [image for image in self.note.images if image is not self]
        self.note._schedule_save()
        self.note._reapply_click_through()

    def to_record(self) -> dict:
        return {
            "id": self.image_id,
            "path": self.path,
            "store_path": self.store_path,
            "name": self.name,
            "data": "" if self.store_path else self.data,
            "x": int(self.x),
            "y": int(self.y),
            "width": int(self.width),
            "height": int(self.height),
        }


def handle_restore_option(restore_value: str) -> None:
    notes = get_recent_notes()
    if not notes:
        return
    value = (restore_value or "prompt").strip().lower()
    if value == "all":
        to_restore = notes
    elif value == "prompt":
        root = tk.Tk()
        root.withdraw()
        qty = simpledialog.askinteger(
            "Restaurar notitas",
            "¿Cuantas notas previas abrir?\n0 = cancelar, -1 = todas",
            initialvalue=2,
            minvalue=-1,
            maxvalue=500,
            parent=root,
        )
        root.destroy()
        if qty is None or qty == 0:
            return
        to_restore = notes if qty == -1 else notes[:qty]
    else:
        try:
            qty_n = int(value)
        except ValueError:
            qty_n = 0
        if qty_n <= 0:
            return
        to_restore = notes[:qty_n]

    for rec in to_restore:
        spawn_note_from_record(rec)


class GhostNote:
    def __init__(self, args: argparse.Namespace, text: str) -> None:
        self.note_id = args.note_id.strip() or uuid.uuid4().hex
        self.requested_frameless = bool(args.frameless)
        self.initial_click_through = bool(args.click_through)
        self.root = tk.Tk()
        self.dnd_available = self._load_tkdnd()
        self.input_shape = X11InputShape()
        self.frameless = bool(self.requested_frameless or (self.initial_click_through and self.input_shape.available))
        # En Linux/Openbox, overrideredirect puede bloquear la escritura.
        # Por eso modo normal por defecto; frameless solo bajo demanda.
        self.root.overrideredirect(self.frameless)
        self.root.attributes("-topmost", bool(args.topmost))

        self.active_opacity = max(0.35, min(1.0, args.active_opacity))
        self.idle_opacity = max(0.05, min(self.active_opacity, args.idle_opacity))
        self._set_opacity(self.idle_opacity)

        self.bg = args.bg
        self.fg = args.fg
        self.font_size = max(7, min(24, int(args.font_size)))
        self.font_family = (args.font_family or "Sans").strip() or "Sans"
        self.root.configure(bg=self.bg)

        width = max(120, args.width)
        height = max(56, args.height)
        if not text.strip() and args.x is None and args.y is None:
            # Nota nueva vacia: minima presencia por defecto.
            width = min(width, 140)
            height = min(height, 70)
        sw = self.root.winfo_screenwidth()
        sh = self.root.winfo_screenheight()
        self.root.update_idletasks()
        if args.x is not None and args.y is not None:
            x = args.x
            y = args.y
        else:
            px = self.root.winfo_pointerx()
            py = self.root.winfo_pointery()
            if px > 1 and py > 1:
                x = max(0, min(px - (width // 2), sw - width))
                y = max(0, min(py - (height // 2), sh - height))
            else:
                x = max(0, (sw - width) // 2)
                y = max(0, (sh - height) // 2)
        self.root.geometry(f"{width}x{height}+{x}+{y}")

        self.drag_start = (0, 0)
        self.drag_offset = (0, 0)
        self.resize_start = (0, 0, width, height)
        self._save_job: str | None = None
        self.has_custom_input_shape = False

        self.initial_format = self._parse_json_list(args.format_json)
        self.initial_images = self._parse_json_list(args.images_json)
        self.read_only = bool(args.read_only)
        self.click_through = False
        self.pending_style_tags: set[str] = set()
        self.images: list[FloatingImage] = []
        self.toolbar_visible = False
        self.toolbar_hide_job: str | None = None
        self.opacity_idle_job: str | None = None
        self._build_ui(text, read_only=self.read_only)
        self._save_now()

    def _parse_json_list(self, value: str) -> list[dict]:
        if not value:
            return []
        try:
            parsed = json.loads(value)
        except json.JSONDecodeError:
            return []
        return parsed if isinstance(parsed, list) else []

    def _load_tkdnd(self) -> bool:
        if TkinterDnD is None:
            return False
        try:
            TkinterDnD._require(self.root)
        except Exception:
            return False
        return True

    def _build_ui(self, text: str, read_only: bool = False) -> None:
        self.body = tk.Frame(self.root, bg=self.bg, highlightthickness=0, bd=0)
        self.body.pack(fill="both", expand=True)

        self.toolbar = tk.Frame(self.body, bg="#c8c8c8", highlightthickness=0, bd=0)
        self.toolbar_handle = tk.Frame(self.body, bg="#a6a6a6", height=10, cursor="hand2")
        self.toolbar_handle.pack(fill="x", side="top")
        self.toolbar_handle.bind("<Enter>", lambda _: self._show_toolbar())
        self.toolbar.bind("<Enter>", lambda _: self._show_toolbar())
        self.toolbar.bind("<Leave>", lambda _: self._schedule_toolbar_hide())

        self.text_widget = tk.Text(
            self.body,
            bg=self.bg,
            fg=self.fg,
            relief="flat",
            wrap="word",
            padx=6,
            pady=4,
            font=(self.font_family, self.font_size),
            insertbackground="#5d5d5d",
            highlightthickness=0,
            bd=0,
            undo=True,
            autoseparators=True,
            maxundo=120,
        )
        self.text_widget.pack(fill="both", expand=True)
        self._configure_text_tags()
        self._build_toolbar()
        if text:
            self.text_widget.insert("1.0", text)
        self._restore_format_ranges(self.initial_format)
        self.text_widget.edit_reset()
        self.text_widget.edit_modified(False)
        if read_only:
            self.text_widget.configure(state="disabled")
        else:
            self.text_widget.configure(state="normal")
            self.text_widget.bind("<Button-1>", lambda _: self.text_widget.focus_force())
