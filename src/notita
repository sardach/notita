        style_menu.add_command(label="Titulo", command=lambda: self._toggle_style("fmt_title"))
        style_menu.add_separator()
        style_menu.add_command(label="Insertar imagen/GIF...", command=self._insert_image_dialog)
        style_menu.add_command(label="Limpiar formato", command=self._clear_selection_format)
        self.context_menu.add_cascade(label="Formato", menu=style_menu)

        self.topmost_var = tk.BooleanVar(value=bool(self.root.attributes("-topmost")))
        self.context_menu.add_checkbutton(label="Siempre encima", variable=self.topmost_var, command=self._toggle_topmost)
        self.read_only_var = tk.BooleanVar(value=bool(self.read_only))
        self.context_menu.add_checkbutton(label="Bloquear edicion", variable=self.read_only_var, command=self._toggle_read_only)
        self.click_through_var = tk.BooleanVar(value=bool(self.click_through))
        self.context_menu.add_checkbutton(label="Dejar pasar clics", variable=self.click_through_var, command=self._toggle_click_through)
        self.context_menu.add_separator()
        self.context_menu.add_command(label="Cerrar nota", command=self._close)

    def _open_context_menu(self, event: tk.Event) -> None:
        self._build_context_menu()
        try:
            self.context_menu.tk_popup(event.x_root, event.y_root)
        finally:
            self.context_menu.grab_release()
        return "break"

    def _history_menu_label(self, record: dict) -> str:
        text = " ".join(str(record.get("text", "")).split())
        image_count = len(record.get("images", []) or [])
        if not text:
            text = f"{image_count} imagen(es)" if image_count else "Nota vacia"
        if len(text) > 44:
            text = text[:41].rstrip() + "..."
        updated = int(record.get("updated_at", 0) or 0)
        stamp = time.strftime("%d/%m %H:%M", time.localtime(updated)) if updated else "sin fecha"
        return f"{stamp}  {text}"

    def _spawn_empty_note(self) -> None:
        subprocess.Popen([sys.executable, __file__], start_new_session=True)

    def _duplicate_note(self) -> None:
        cmd = [
            sys.executable,
            __file__,
            "--width",
            str(self.root.winfo_width()),
            "--height",
            str(self.root.winfo_height()),
            "--active-opacity",
            str(self.active_opacity),
            "--idle-opacity",
            str(self.idle_opacity),
            "--bg",
            self.bg,
            "--fg",
            self.fg,
            "--font-size",
            str(self.font_size),
            "--font-family",
            self.font_family,
            "--format-json",
            json.dumps(self._dump_format_ranges(), ensure_ascii=False),
            "--images-json",
            json.dumps(self._dump_images(), ensure_ascii=False),
        ]
        if self.click_through:
            cmd.append("--click-through")
        cmd.append(self.text_widget.get("1.0", "end-1c"))
        subprocess.Popen(cmd, start_new_session=True)

    def _export_note_dialog(self) -> None:
        self._save_now()
        initial = self._suggest_export_name()
        path = filedialog.asksaveasfilename(
            parent=self.root,
            title="Guardar notita",
            initialfile=initial,
            defaultextension=".md",
            filetypes=[
                ("Markdown", "*.md"),
                ("Texto plano", "*.txt"),
            ],
        )
        if not path:
            return
        target = Path(path).expanduser()
        if target.suffix.lower() not in {".md", ".txt"}:
            target = target.with_suffix(".md")
        try:
            self._export_note_to_path(target)
        except OSError as exc:
            messagebox.showerror("No se pudo guardar", str(exc), parent=self.root)
            return
        messagebox.showinfo("Notita guardada", f"Guardada en:\n{target}", parent=self.root)

    def _suggest_export_name(self) -> str:
        text = " ".join(self.text_widget.get("1.0", "end-1c").split())
        if not text:
            text = "notita"
        return f"{self._safe_filename(text[:32])}.md"

    def _export_note_to_path(self, target: Path) -> None:
        target.parent.mkdir(parents=True, exist_ok=True)
        text = self.text_widget.get("1.0", "end-1c").rstrip()
        images = self._dump_images()
        if target.suffix.lower() == ".txt":
            content = self._export_as_text(text, images)
        else:
            content = self._export_as_markdown(target, text, images)
        target.write_text(content, encoding="utf-8")

    def _export_as_text(self, text: str, images: list[dict]) -> str:
        lines = [text] if text else []
        if images:
            if lines:
                lines.append("")
            lines.append("Imagenes:")
            for image in images:
                name = str(image.get("name") or "imagen")
                source = str(image.get("store_path") or image.get("path") or "")
                lines.append(f"- {name}: {source}")
        return "\n".join(lines).rstrip() + "\n"

    def _export_as_markdown(self, target: Path, text: str, images: list[dict]) -> str:
        parts = [text] if text else []
        links = []
        if images:
            assets_dir = target.parent / f"{target.stem}_assets"
            assets_dir.mkdir(parents=True, exist_ok=True)
            used_names: set[str] = set()
            for image in images:
                source = Path(str(image.get("store_path") or image.get("path") or ""))
                if not source.is_file():
                    continue
                base_name = self._safe_filename(str(image.get("name") or source.name))
                if not Path(base_name).suffix:
                    base_name += source.suffix or ".img"
                dest_name = self._unique_asset_name(base_name, used_names)
                used_names.add(dest_name)
                dest = assets_dir / dest_name
                shutil.copy2(source, dest)
                rel = dest.relative_to(target.parent).as_posix()
                alt = str(image.get("name") or dest_name).replace("]", "")
                links.append(f"![{alt}]({rel})")
        if links:
            if parts:
                parts.append("")
            parts.append("## Imagenes")
            parts.extend(links)
        return "\n\n".join(parts).rstrip() + "\n"

    def _unique_asset_name(self, name: str, used_names: set[str]) -> str:
        candidate = name
        stem = Path(name).stem or "imagen"
        suffix = Path(name).suffix
        idx = 2
        while candidate in used_names:
            candidate = f"{stem}-{idx}{suffix}"
            idx += 1
        return candidate

    def _safe_filename(self, value: str) -> str:
        safe = "".join(ch if ch.isalnum() or ch in {"-", "_", "."} else "_" for ch in value.strip())
        safe = safe.strip("._")
        return safe or "notita"

    def _set_custom_size(self) -> None:
        w = simpledialog.askinteger("Ancho", "Nuevo ancho:", initialvalue=self.root.winfo_width(), minvalue=140, maxvalue=2400)
        if w is None:
            return
        h = simpledialog.askinteger("Alto", "Nuevo alto:", initialvalue=self.root.winfo_height(), minvalue=70, maxvalue=1600)
        if h is None:
            return
        self.root.geometry(f"{w}x{h}")
        self._schedule_save()

    def _bump_font(self, delta: int) -> None:
        font_obj = tkfont.nametofont(self.text_widget.cget("font"))
        current = int(font_obj.cget("size"))
        self.font_size = max(7, min(24, current + delta))
        self.text_widget.configure(font=(self.font_family, self.font_size))
        self._configure_text_tags()
        self._schedule_save()

    def _set_font(self) -> None:
        current_font = tkfont.nametofont(self.text_widget.cget("font"))
        current_family = current_font.cget("family")
        current_size = int(current_font.cget("size"))
        family = simpledialog.askstring(
            "Fuente",
            "Familia tipografica (ej: Sans, Monospace, DejaVu Sans):",
            initialvalue=current_family,
            parent=self.root,
        )
        if family is None:
            return
        size = simpledialog.askinteger(
            "Tamano de fuente",
            "Tamano (7-24):",
            initialvalue=current_size,
            minvalue=7,
            maxvalue=24,
            parent=self.root,
        )
        if size is None:
            return
        self.font_family = family.strip() or current_family
        self.font_size = int(size)
        self.text_widget.configure(font=(self.font_family, self.font_size))
        self._configure_text_tags()
        self._schedule_save()

    def _clear_history_with_confirm(self) -> None:
        answer = simpledialog.askstring(
            "Limpiar historial",
            "Escribe LIMPIAR para confirmar:",
            parent=self.root,
        )
        if (answer or "").strip() == "LIMPIAR":
            clear_history()
            self._save_now()
        self._schedule_save()

    def _shift_opacity(self, idle_delta: float, active_delta: float) -> None:
        self.idle_opacity = max(0.05, min(0.9, self.idle_opacity + idle_delta))
        self.active_opacity = max(self.idle_opacity, min(1.0, self.active_opacity + active_delta))
        self._refresh_opacity_for_pointer()
        self._schedule_save()

    def _set_active_opacity(self) -> None:
        value = simpledialog.askfloat("Opacidad activa", "Valor 0.35 - 1.0", initialvalue=self.active_opacity, minvalue=0.35, maxvalue=1.0)
        if value is None:
            return
        self.active_opacity = max(self.idle_opacity, min(1.0, value))
        self._refresh_opacity_for_pointer()
        self._schedule_save()

    def _set_idle_opacity(self) -> None:
        value = simpledialog.askfloat("Opacidad inactiva", "Valor 0.05 - opacidad activa", initialvalue=self.idle_opacity, minvalue=0.05, maxvalue=self.active_opacity)
        if value is None:
            return
        self.idle_opacity = max(0.05, min(self.active_opacity, value))
        self._refresh_opacity_for_pointer()
        self._schedule_save()

    def _set_bg_color(self) -> None:
        picked = colorchooser.askcolor(title="Color de fondo", color=self.bg)[1]
        if not picked:
            return
        self.bg = picked
        self.root.configure(bg=self.bg)
        self.text_widget.configure(bg=self.bg)
        self._schedule_save()

    def _set_fg_color(self) -> None:
        picked = colorchooser.askcolor(title="Color de texto", color=self.fg)[1]
        if not picked:
            return
        self.fg = picked
        self.text_widget.configure(fg=self.fg)
        self._schedule_save()

    def _toggle_topmost(self) -> None:
        self.root.attributes("-topmost", bool(self.topmost_var.get()))
        self._schedule_save()

    def _toggle_read_only(self) -> None:
        self.read_only = bool(self.read_only_var.get())
        if self.read_only:
            self.text_widget.configure(state="disabled")
        else:
            self.text_widget.configure(state="normal")
            self.text_widget.focus_force()
            self.text_widget.mark_set("insert", "end")
        self._schedule_save()

    def _toggle_click_through(self) -> None:
        self._set_click_through(bool(self.click_through_var.get()))

    def _set_click_through(self, enabled: bool, persist: bool = True) -> bool:
        enabled = bool(enabled)
        previous_click_through = self.click_through
        previous_frameless = self.frameless

        if enabled and not self.input_shape.available:
            self.click_through = False
            if hasattr(self, "click_through_var"):
                self.click_through_var.set(False)
            if persist:
                self._schedule_save()
            return False

        target_frameless = bool(self.requested_frameless or enabled)
        if target_frameless != self.frameless:
            self.frameless = target_frameless
            self.root.overrideredirect(target_frameless)
            self.root.update_idletasks()
            if target_frameless:
                self.root.lift()

        if enabled:
            if self._apply_click_through():
                self.click_through = True
                self.has_custom_input_shape = True
                self.root.after(160, self._reapply_click_through)
                self.root.after(500, self._reapply_click_through)
            else:
                self.click_through = previous_click_through
                self.frameless = previous_frameless
                self.root.overrideredirect(previous_frameless)
                self.root.update_idletasks()
                enabled = False
        else:
            if self.has_custom_input_shape:
                self.input_shape.set_passthrough(self.root, False)
            self.click_through = False
        if hasattr(self, "click_through_var"):
            self.click_through_var.set(self.click_through)
        if persist:
            self._schedule_save()
        return enabled and self.click_through

    def _apply_click_through(self) -> bool:
        control_widgets = self._click_through_control_widgets()
        if self.input_shape.set_passthrough(self.root, True, control_widgets):
            self._set_opacity(self.idle_opacity)
            return True
        return False

    def _click_through_control_widgets(self) -> set[tk.Misc]:
        widgets = {self.move_grip, self.resize_grip, self.toolbar_handle}
        if self.toolbar_visible:
            widgets.add(self.toolbar)
            widgets.update(self.toolbar.winfo_children())
        for image in self.images:
            widgets.add(image.frame)
            widgets.add(image.label)
            widgets.add(image.grip)
        return widgets

    def _reapply_click_through(self) -> None:
        if self.click_through:
            self._apply_click_through()

    def _start_drag(self, event: tk.Event) -> None:
        self.drag_start = (event.x_root, event.y_root)
        self.drag_offset = (
            event.x_root - self.root.winfo_x(),
            event.y_root - self.root.winfo_y(),
        )

    def _drag(self, event: tk.Event) -> None:
        ox, oy = self.drag_offset
        x = event.x_root - ox
        y = event.y_root - oy
        self.root.geometry(f"+{x}+{y}")
        self._schedule_save()

    def _start_resize(self, event: tk.Event) -> None:
        self.resize_start = (
            event.x_root,
            event.y_root,
            self.root.winfo_width(),
            self.root.winfo_height(),
        )

    def _resize(self, event: tk.Event) -> None:
        sx, sy, sw, sh = self.resize_start
        nw = max(140, sw + (event.x_root - sx))
        nh = max(70, sh + (event.y_root - sy))
        self.root.geometry(f"{nw}x{nh}")
        self._schedule_save()

    def _on_text_modified(self, _: tk.Event) -> None:
        if self.text_widget.edit_modified():
            self.text_widget.edit_modified(False)
            self._schedule_save()

    def _on_configure(self, _: tk.Event) -> None:
        self._schedule_save()
        self.root.after_idle(self._refresh_opacity_for_pointer)
        if self.click_through:
            self.root.after_idle(self._reapply_click_through)

    def _schedule_save(self) -> None:
        if self._save_job is not None:
            self.root.after_cancel(self._save_job)
        self._save_job = self.root.after(350, self._save_now)

    def _save_now(self) -> None:
        self._save_job = None
        text_value = self.text_widget.get("1.0", "end-1c")
        image_records = self._dump_images()
        if not text_value.strip() and not image_records:
            delete_note_record(self.note_id)
            return
        rec = {
            "id": self.note_id,
            "text": text_value,
            "x": int(self.root.winfo_x()),
            "y": int(self.root.winfo_y()),
            "width": int(self.root.winfo_width()),
            "height": int(self.root.winfo_height()),
            "active_opacity": float(self.active_opacity),
            "idle_opacity": float(self.idle_opacity),
            "bg": self.bg,
            "fg": self.fg,
            "font_size": int(self.font_size),
            "font_family": self.font_family,
            "topmost": bool(self.root.attributes("-topmost")),
            "read_only": bool(self.read_only),
            "click_through": bool(self.click_through),
            "format": self._dump_format_ranges(),
            "images": image_records,
            "updated_at": int(time.time()),
        }
        upsert_note_record(rec)

    def _close(self) -> None:
        self._save_now()
        self.root.destroy()

    def run(self) -> None:
        self.root.mainloop()


def main() -> None:
    args = parse_args()
    text = " ".join(args.text)

    if args.restore is not None:
        handle_restore_option(args.restore)
        if not text.strip():
            return

    app = GhostNote(args=args, text=text)
    app.run()


if __name__ == "__main__":
    main()
