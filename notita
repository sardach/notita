#!/usr/bin/env python3
"""Notita en modo sigilo extremo con historial/restauracion."""

from __future__ import annotations

import argparse
import json
import os
import random
import subprocess
import sys
import time
import uuid
from pathlib import Path

import tkinter as tk
import tkinter.font as tkfont
from tkinter import colorchooser, simpledialog

STATE_DIR = Path.home() / ".local" / "state" / "notita"
HISTORY_FILE = STATE_DIR / "history.json"
LOCK_FILE = STATE_DIR / "history.lock"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Crear notita de sigilo extremo.")
    parser.add_argument("text", nargs="*", help="Texto inicial")
    parser.add_argument("--width", type=int, default=140)
    parser.add_argument("--height", type=int, default=70)
    parser.add_argument("--x", type=int)
    parser.add_argument("--y", type=int)
    parser.add_argument("--active-opacity", type=float, default=0.72)
    parser.add_argument("--idle-opacity", type=float, default=0.18)
    parser.add_argument("--bg", default="#d7d7d7")
    parser.add_argument("--fg", default="#2f2f2f")
    parser.add_argument("--font-size", type=int, default=9)
    parser.add_argument("--font-family", default="Sans")
    parser.add_argument("--read-only", action="store_true", help="Abrir sin modo edicion")
    parser.add_argument("--frameless", action="store_true", help="Sin decoraciones (puede romper escritura en Linux)")
    parser.add_argument("--topmost", dest="topmost", action="store_true", default=True)
    parser.add_argument("--no-topmost", dest="topmost", action="store_false")
    parser.add_argument("--note-id", default="")
    parser.add_argument(
        "--restore",
        nargs="?",
        const="prompt",
        help="Restaurar historial: prompt | all | N",
    )
    return parser.parse_args()


def _ensure_state() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)


def _read_history() -> dict:
    _ensure_state()
    if not HISTORY_FILE.exists():
        return {"notes": []}
    try:
        return json.loads(HISTORY_FILE.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return {"notes": []}


def _write_history(data: dict) -> None:
    _ensure_state()
    tmp = HISTORY_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
    os.replace(tmp, HISTORY_FILE)


def upsert_note_record(record: dict) -> None:
    data = _read_history()
    notes = data.get("notes", [])
    notes = [n for n in notes if n.get("id") != record.get("id")]
    notes.append(record)
    notes = sorted(notes, key=lambda n: n.get("updated_at", 0), reverse=True)[:500]
    data["notes"] = notes
    _write_history(data)


def delete_note_record(note_id: str) -> None:
    if not note_id:
        return
    data = _read_history()
    notes = data.get("notes", [])
    data["notes"] = [n for n in notes if n.get("id") != note_id]
    _write_history(data)


def clear_history() -> None:
    _write_history({"notes": []})


def get_recent_notes() -> list[dict]:
    data = _read_history()
    notes = data.get("notes", [])
    return sorted(notes, key=lambda n: n.get("updated_at", 0), reverse=True)


def spawn_note_from_record(record: dict) -> None:
    cmd = [
        sys.executable,
        __file__,
        "--note-id",
        str(record.get("id", "")),
        "--width",
        str(int(record.get("width", 210))),
        "--height",
        str(int(record.get("height", 110))),
        "--x",
        str(int(record.get("x", 100))),
        "--y",
        str(int(record.get("y", 100))),
        "--active-opacity",
        str(float(record.get("active_opacity", 0.72))),
        "--idle-opacity",
        str(float(record.get("idle_opacity", 0.18))),
        "--bg",
        str(record.get("bg", "#d7d7d7")),
        "--fg",
        str(record.get("fg", "#2f2f2f")),
        "--font-size",
        str(int(record.get("font_size", 9))),
        "--font-family",
        str(record.get("font_family", "Sans")),
        str(record.get("text", "")),
    ]
    if record.get("topmost"):
        cmd.append("--topmost")
    if record.get("read_only"):
        cmd.append("--read-only")
    subprocess.Popen(cmd, start_new_session=True)


def handle_restore_option(restore_value: str) -> None:
    notes = get_recent_notes()
    if not notes:
        return
    value = (restore_value or "prompt").strip().lower()
    if value == "all":
        to_restore = notes
    elif value == "prompt":
        root = tk.Tk()
        root.withdraw()
        qty = simpledialog.askinteger(
            "Restaurar notitas",
            "¿Cuantas notas previas abrir?\n0 = cancelar, -1 = todas",
            initialvalue=2,
            minvalue=-1,
            maxvalue=500,
            parent=root,
        )
        root.destroy()
        if qty is None or qty == 0:
            return
        to_restore = notes if qty == -1 else notes[:qty]
    else:
        try:
            qty_n = int(value)
        except ValueError:
            qty_n = 0
        if qty_n <= 0:
            return
        to_restore = notes[:qty_n]

    for rec in to_restore:
        spawn_note_from_record(rec)


class GhostNote:
    def __init__(self, args: argparse.Namespace, text: str) -> None:
        self.note_id = args.note_id.strip() or uuid.uuid4().hex
        self.frameless = bool(args.frameless)
        self.root = tk.Tk()
        # En Linux/Openbox, overrideredirect puede bloquear la escritura.
        # Por eso modo normal por defecto; frameless solo bajo demanda.
        self.root.overrideredirect(self.frameless)
        self.root.attributes("-topmost", bool(args.topmost))

        self.active_opacity = max(0.35, min(1.0, args.active_opacity))
        self.idle_opacity = max(0.05, min(self.active_opacity, args.idle_opacity))
        self.root.attributes("-alpha", self.idle_opacity)

        self.bg = args.bg
        self.fg = args.fg
        self.font_size = max(7, min(24, int(args.font_size)))
        self.font_family = (args.font_family or "Sans").strip() or "Sans"
        self.root.configure(bg=self.bg)

        width = max(120, args.width)
        height = max(56, args.height)
        if not text.strip() and args.x is None and args.y is None:
            # Nota nueva vacia: minima presencia por defecto.
            width = min(width, 140)
            height = min(height, 70)
        sw = self.root.winfo_screenwidth()
        sh = self.root.winfo_screenheight()
        self.root.update_idletasks()
        if args.x is not None and args.y is not None:
            x = args.x
            y = args.y
        else:
            px = self.root.winfo_pointerx()
            py = self.root.winfo_pointery()
            if px > 1 and py > 1:
                x = max(0, min(px - (width // 2), sw - width))
                y = max(0, min(py - (height // 2), sh - height))
            else:
                x = max(0, (sw - width) // 2)
                y = max(0, (sh - height) // 2)
        self.root.geometry(f"{width}x{height}+{x}+{y}")

        self.drag_start = (0, 0)
        self.drag_offset = (0, 0)
        self.resize_start = (0, 0, width, height)
        self._save_job: str | None = None

        self.read_only = bool(args.read_only)
        self._build_ui(text, read_only=self.read_only)
        self._save_now()

    def _build_ui(self, text: str, read_only: bool = False) -> None:
        body = tk.Frame(self.root, bg=self.bg, highlightthickness=0, bd=0)
        body.pack(fill="both", expand=True)

        self.text_widget = tk.Text(
            body,
            bg=self.bg,
            fg=self.fg,
            relief="flat",
            wrap="word",
            padx=6,
            pady=4,
            font=(self.font_family, self.font_size),
            insertbackground="#5d5d5d",
            highlightthickness=0,
            bd=0,
        )
        self.text_widget.pack(fill="both", expand=True)
        if text:
            self.text_widget.insert("1.0", text)
        if read_only:
            self.text_widget.configure(state="disabled")
        else:
            self.text_widget.configure(state="normal")
            self.text_widget.bind("<Button-1>", lambda _: self.text_widget.focus_force())

        self.resize_grip = tk.Frame(self.root, bg="#8a8a8a", width=10, height=10, cursor="bottom_right_corner")
        self.resize_grip.place(relx=1.0, rely=1.0, anchor="se")

        self.move_grip = tk.Label(
            self.root,
            text="⠿",
            bg="#9a9a9a",
            fg="#2f2f2f",
            width=2,
            height=1,
            cursor="fleur",
            font=("Sans", 8),
            bd=0,
            padx=0,
            pady=0,
        )
        self.move_grip.place(relx=0.0, rely=1.0, anchor="sw", x=0, y=0)

        self.text_widget.bind("<Alt-ButtonPress-1>", self._start_drag)
        self.text_widget.bind("<Alt-B1-Motion>", self._drag)
        self.move_grip.bind("<ButtonPress-1>", self._start_drag)
        self.move_grip.bind("<B1-Motion>", self._drag)
        self.resize_grip.bind("<ButtonPress-1>", self._start_resize)
        self.resize_grip.bind("<B1-Motion>", self._resize)

        self.context_menu = tk.Menu(self.root, tearoff=0)
        self._build_context_menu()
        self.text_widget.bind("<Button-3>", self._open_context_menu)
        self.root.bind("<Button-3>", self._open_context_menu)

        self.root.bind("<Enter>", lambda _: self.root.attributes("-alpha", self.active_opacity))
        self.root.bind("<Leave>", lambda _: self.root.attributes("-alpha", self.idle_opacity))
        self.root.bind("<FocusIn>", lambda _: self.root.attributes("-alpha", self.active_opacity))
        self.root.bind("<FocusOut>", lambda _: self.root.attributes("-alpha", self.idle_opacity))

        self.text_widget.bind("<<Modified>>", self._on_text_modified)
        self.root.bind("<Configure>", lambda _: self._schedule_save())
        self.root.protocol("WM_DELETE_WINDOW", self._close)
        self.root.bind("<Escape>", lambda _: self._close())
        self.root.bind("<Control-q>", lambda _: self._close())
        # Fuerza foco/edicion al abrir (overrideredirect puede requerir retraso)
        self.root.after(10, self._force_focus)

    def _force_focus(self) -> None:
        try:
            self.root.lift()
            self.root.focus_force()
            if self.read_only:
                self.text_widget.configure(state="disabled")
            else:
                self.text_widget.configure(state="normal")
                self.text_widget.focus_force()
                self.text_widget.mark_set("insert", "end")
        except tk.TclError:
            return

    def _build_context_menu(self) -> None:
        self.context_menu.delete(0, "end")
        self.context_menu.add_command(label="Nueva nota vacia", command=self._spawn_empty_note)
        self.context_menu.add_command(label="Duplicar nota", command=self._duplicate_note)

        hist = tk.Menu(self.context_menu, tearoff=0)
        hist.add_command(label="Restaurar 2 recientes", command=lambda: handle_restore_option("2"))
        hist.add_command(label="Restaurar N...", command=lambda: handle_restore_option("prompt"))
        hist.add_command(label="Restaurar todas", command=lambda: handle_restore_option("all"))
        hist.add_separator()
        hist.add_command(label="Limpiar historial", command=self._clear_history_with_confirm)
        self.context_menu.add_cascade(label="Historial", menu=hist)

        self.context_menu.add_separator()
        self.context_menu.add_command(label="Limpiar texto", command=lambda: self.text_widget.delete("1.0", "end"))
        self.context_menu.add_command(label="Editar ancho/alto", command=self._set_custom_size)
        self.context_menu.add_command(label="Fuente (+)", command=lambda: self._bump_font(1))
        self.context_menu.add_command(label="Fuente (-)", command=lambda: self._bump_font(-1))
        self.context_menu.add_command(label="Cambiar fuente...", command=self._set_font)

        opacity_menu = tk.Menu(self.context_menu, tearoff=0)
        opacity_menu.add_command(label="Mas visible", command=lambda: self._shift_opacity(0.06, 0.08))
        opacity_menu.add_command(label="Mas sigilo", command=lambda: self._shift_opacity(-0.06, -0.08))
        opacity_menu.add_command(label="Set opacidad activa", command=self._set_active_opacity)
        opacity_menu.add_command(label="Set opacidad inactiva", command=self._set_idle_opacity)
        self.context_menu.add_cascade(label="Opacidad", menu=opacity_menu)

        color_menu = tk.Menu(self.context_menu, tearoff=0)
        color_menu.add_command(label="Color de fondo", command=self._set_bg_color)
        color_menu.add_command(label="Color de texto", command=self._set_fg_color)
        self.context_menu.add_cascade(label="Colores", menu=color_menu)

        self.topmost_var = tk.BooleanVar(value=bool(self.root.attributes("-topmost")))
        self.context_menu.add_checkbutton(label="Siempre encima", variable=self.topmost_var, command=self._toggle_topmost)
        self.read_only_var = tk.BooleanVar(value=bool(self.read_only))
        self.context_menu.add_checkbutton(label="Bloquear edicion", variable=self.read_only_var, command=self._toggle_read_only)
        self.context_menu.add_separator()
        self.context_menu.add_command(label="Cerrar nota", command=self._close)

    def _open_context_menu(self, event: tk.Event) -> None:
        self._build_context_menu()
        self.context_menu.tk_popup(event.x_root, event.y_root)

    def _spawn_empty_note(self) -> None:
        subprocess.Popen([sys.executable, __file__], start_new_session=True)

    def _duplicate_note(self) -> None:
        subprocess.Popen(
            [
                sys.executable,
                __file__,
                "--width",
                str(self.root.winfo_width()),
                "--height",
                str(self.root.winfo_height()),
                "--active-opacity",
                str(self.active_opacity),
                "--idle-opacity",
                str(self.idle_opacity),
                "--bg",
                self.bg,
                "--fg",
                self.fg,
                "--font-size",
                str(self.font_size),
                "--font-family",
                self.font_family,
                self.text_widget.get("1.0", "end-1c"),
            ],
            start_new_session=True,
        )

    def _set_custom_size(self) -> None:
        w = simpledialog.askinteger("Ancho", "Nuevo ancho:", initialvalue=self.root.winfo_width(), minvalue=140, maxvalue=2400)
        if w is None:
            return
        h = simpledialog.askinteger("Alto", "Nuevo alto:", initialvalue=self.root.winfo_height(), minvalue=70, maxvalue=1600)
        if h is None:
            return
        self.root.geometry(f"{w}x{h}")
        self._schedule_save()

    def _bump_font(self, delta: int) -> None:
        font_obj = tkfont.nametofont(self.text_widget.cget("font"))
        current = int(font_obj.cget("size"))
        self.font_size = max(7, min(24, current + delta))
        self.text_widget.configure(font=(self.font_family, self.font_size))
        self._schedule_save()

    def _set_font(self) -> None:
        current_font = tkfont.nametofont(self.text_widget.cget("font"))
        current_family = current_font.cget("family")
        current_size = int(current_font.cget("size"))
        family = simpledialog.askstring(
            "Fuente",
            "Familia tipografica (ej: Sans, Monospace, DejaVu Sans):",
            initialvalue=current_family,
            parent=self.root,
        )
        if family is None:
            return
        size = simpledialog.askinteger(
            "Tamano de fuente",
            "Tamano (7-24):",
            initialvalue=current_size,
            minvalue=7,
            maxvalue=24,
            parent=self.root,
        )
        if size is None:
            return
        self.font_family = family.strip() or current_family
        self.font_size = int(size)
        self.text_widget.configure(font=(self.font_family, self.font_size))
        self._schedule_save()

    def _clear_history_with_confirm(self) -> None:
        answer = simpledialog.askstring(
            "Limpiar historial",
            "Escribe LIMPIAR para confirmar:",
            parent=self.root,
        )
        if (answer or "").strip() == "LIMPIAR":
            clear_history()
            self._save_now()
        self._schedule_save()

    def _shift_opacity(self, idle_delta: float, active_delta: float) -> None:
        self.idle_opacity = max(0.05, min(0.9, self.idle_opacity + idle_delta))
        self.active_opacity = max(self.idle_opacity, min(1.0, self.active_opacity + active_delta))
        self.root.attributes("-alpha", self.active_opacity)
        self._schedule_save()

    def _set_active_opacity(self) -> None:
        value = simpledialog.askfloat("Opacidad activa", "Valor 0.35 - 1.0", initialvalue=self.active_opacity, minvalue=0.35, maxvalue=1.0)
        if value is None:
            return
        self.active_opacity = max(self.idle_opacity, min(1.0, value))
        self.root.attributes("-alpha", self.active_opacity)
        self._schedule_save()

    def _set_idle_opacity(self) -> None:
        value = simpledialog.askfloat("Opacidad inactiva", "Valor 0.05 - opacidad activa", initialvalue=self.idle_opacity, minvalue=0.05, maxvalue=self.active_opacity)
        if value is None:
            return
        self.idle_opacity = max(0.05, min(self.active_opacity, value))
        self.root.attributes("-alpha", self.idle_opacity)
        self._schedule_save()

    def _set_bg_color(self) -> None:
        picked = colorchooser.askcolor(title="Color de fondo", color=self.bg)[1]
        if not picked:
            return
        self.bg = picked
        self.root.configure(bg=self.bg)
        self.text_widget.configure(bg=self.bg)
        self._schedule_save()

    def _set_fg_color(self) -> None:
        picked = colorchooser.askcolor(title="Color de texto", color=self.fg)[1]
        if not picked:
            return
        self.fg = picked
        self.text_widget.configure(fg=self.fg)
        self._schedule_save()

    def _toggle_topmost(self) -> None:
        self.root.attributes("-topmost", bool(self.topmost_var.get()))
        self._schedule_save()

    def _toggle_read_only(self) -> None:
        self.read_only = bool(self.read_only_var.get())
        if self.read_only:
            self.text_widget.configure(state="disabled")
        else:
            self.text_widget.configure(state="normal")
            self.text_widget.focus_force()
            self.text_widget.mark_set("insert", "end")
        self._schedule_save()

    def _start_drag(self, event: tk.Event) -> None:
        self.drag_start = (event.x_root, event.y_root)
        self.drag_offset = (
            event.x_root - self.root.winfo_x(),
            event.y_root - self.root.winfo_y(),
        )

    def _drag(self, event: tk.Event) -> None:
        ox, oy = self.drag_offset
        x = event.x_root - ox
        y = event.y_root - oy
        self.root.geometry(f"+{x}+{y}")
        self._schedule_save()

    def _start_resize(self, event: tk.Event) -> None:
        self.resize_start = (
            event.x_root,
            event.y_root,
            self.root.winfo_width(),
            self.root.winfo_height(),
        )

    def _resize(self, event: tk.Event) -> None:
        sx, sy, sw, sh = self.resize_start
        nw = max(140, sw + (event.x_root - sx))
        nh = max(70, sh + (event.y_root - sy))
        self.root.geometry(f"{nw}x{nh}")
        self._schedule_save()

    def _on_text_modified(self, _: tk.Event) -> None:
        if self.text_widget.edit_modified():
            self.text_widget.edit_modified(False)
            self._schedule_save()

    def _schedule_save(self) -> None:
        if self._save_job is not None:
            self.root.after_cancel(self._save_job)
        self._save_job = self.root.after(350, self._save_now)

    def _save_now(self) -> None:
        self._save_job = None
        text_value = self.text_widget.get("1.0", "end-1c")
        if not text_value.strip():
            delete_note_record(self.note_id)
            return
        rec = {
            "id": self.note_id,
            "text": text_value,
            "x": int(self.root.winfo_x()),
            "y": int(self.root.winfo_y()),
            "width": int(self.root.winfo_width()),
            "height": int(self.root.winfo_height()),
            "active_opacity": float(self.active_opacity),
            "idle_opacity": float(self.idle_opacity),
            "bg": self.bg,
            "fg": self.fg,
            "font_size": int(self.font_size),
            "font_family": self.font_family,
            "topmost": bool(self.root.attributes("-topmost")),
            "read_only": bool(self.read_only),
            "updated_at": int(time.time()),
        }
        upsert_note_record(rec)

    def _close(self) -> None:
        self._save_now()
        self.root.destroy()

    def run(self) -> None:
        self.root.mainloop()


def main() -> None:
    args = parse_args()
    text = " ".join(args.text)

    if args.restore is not None:
        handle_restore_option(args.restore)
        if not text.strip():
            return

    app = GhostNote(args=args, text=text)
    app.run()


if __name__ == "__main__":
    main()
