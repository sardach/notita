#!/usr/bin/env python3
from __future__ import annotations

import sys
import tkinter as tk
from tkinter import simpledialog


text = " ".join(sys.argv[1:]).strip()
if not text:
    prompt = tk.Tk()
    prompt.withdraw()
    prompt.attributes("-topmost", True)
    text = simpledialog.askstring("Notita", "Texto:", parent=prompt) or ""
    prompt.destroy()

if not text:
    raise SystemExit(0)

root = tk.Tk()
root.attributes("-topmost", True)
root.geometry("260x140+120+120")

box = tk.Text(root, wrap="word", font=("Sans", 10), padx=8, pady=8)
box.pack(fill="both", expand=True)
box.insert("1.0", text)
box.focus_set()

root.mainloop()
